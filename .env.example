# Copy to .env.local and fill in. For production on Turso's free tier:
#   DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=
APP_URL=http://localhost:3000
# Long random string; used to hash visitor IPs for privacy-friendly unique counts.
IP_HASH_SALT=change-me-to-a-long-random-string
# Email (verification + password reset). Leave blank in development: links are printed to the server console.
# For production use Resend's free tier (verify a sending domain first).
RESEND_API_KEY=
EMAIL_FROM=
